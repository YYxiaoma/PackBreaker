{
  "name": "packbreaker-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "format": "prettier --write src vite.config.ts package.json tsconfig.json",
    "lint": "prettier --check src vite.config.ts package.json tsconfig.json",
    "test:e2e": "node ../scripts/check-prototype.cjs"
  },
  "dependencies": {
    "@lucide/vue": "1.41.0",
    "element-plus": "2.14.5",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.0.18",
    "vue-tsc": "3.3.11"
  }
}
